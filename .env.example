# OpenRecon UI environment example. Copy to .env.local and edit.

# Base URL of the OpenRecon API (used by the standalone modules and the
# server-side investigations proxy).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Better Auth.
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Neon Postgres for auth tables (user, session, account, verification).
DATABASE_URL=postgresql://user:password@host/dbname

# API key injected server-side by the investigations proxy. Must match the
# API's API_KEY.
API_KEY=your-api-key

# GitHub OAuth (optional).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=